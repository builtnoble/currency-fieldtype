{
    "name": "builtnoble/currency-fieldtype",
    "description": "A Statamic fieldtype for storing and displaying monetary values as locale-aware, precision-safe integer subunits.",
    "keywords": ["statamic", "statamic-addon", "fieldtype", "currency", "money"],
    "license": "MIT",
    "authors": [
        {
            "name": "Amanda Romero",
            "email": "thetypescriptslayer@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Builtnoble\\CurrencyFieldtype\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Builtnoble\\CurrencyFieldtype\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^4.6"
    },
    "scripts": {
        "test": "pest",
        "test:feature": "pest --group=\"feature\"",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse",
        "check": ["@lint", "@analyse", "@test"]
    },
    "support": {
        "issues": "https://github.com/builtnoble/currency-fieldtype/issues",
        "source": "https://github.com/builtnoble/currency-fieldtype"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Currency Fieldtype",
            "description": "A Statamic fieldtype for storing and displaying monetary values as locale-aware, precision-safe integer subunits.",
            "editions": ["free"]
        },
        "laravel": {
            "providers": ["Builtnoble\\CurrencyFieldtype\\ServiceProvider"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}